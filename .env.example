# Instance

INSTANCE_NAME="Partyboi (dockerized)"
HOST_ADDRESS=localhost
PORT=8123
# Signs session cookies. MUST be a long random hex string, unique per deployment — the app refuses
# the placeholder below outside development. Generate one with: openssl rand -hex 32
SESSION_SIGN_KEY=CHANGE_ME

# Init data

ADMIN_USERNAME=admin
# The initial admin password. The app refuses to create the admin account outside development while
# this is unset or still "password", so set a strong value before first start.
ADMIN_PASSWORD=CHANGE_ME

# Database

DB_PORT=5432
DB_USER=postgres
# Use a strong, unique password. Postgres is only reachable on loopback and the internal network,
# but a weak password is still a real risk if that boundary is ever crossed.
DB_PASSWORD=CHANGE_ME
DB_DATABASE=partyboi

# File locations

DIR_DB=./data/db
FILES_ASSETS=./data/assets
FILES_ENTRIES=./data/entries
FILES_SCREENSHOTS=./data/screenshots
